# ===== DD日推 · Onsite Club 会展监控（每日 9:00 推送钉钉） =====
# 钉钉群机器人 Webhook（自定义机器人 → 安全设置 → 复制 Webhook 地址）
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=你的TOKEN
# 机器人安全关键词（所有推送消息必须包含）
DINGTALK_KEYWORD=会展
# 加签密钥（机器人开启「加签」时填写，否则留空）
DINGTALK_SECRET=
# 看板图床：ImgBB API Key（免费注册 api.imgbb.com）
IMGBB_API_KEY=
# 备选图床：GitHub Token + 仓库（owner/repo），传 raw 直链
GITHUB_TOKEN=
GITHUB_IMAGE_REPO=
# 推送里「未来N天新开」日程窗口天数（1-30，默认 7）
ONSITECLUB_SCHEDULE_DAYS=7
# 进行中会展按距结束天数分四档：≤10天 / 11-20天 / 21-30天 / >30天（>30天按结束月份细分）
ONSITECLUB_END_URGENT=10
ONSITECLUB_END_NEAR=20
ONSITECLUB_END_FAR=30
ONSITECLUB_LONG_CAP=10
# 监控月份：默认当前月（自动滚动）；指定如 2026-08 可固定
# ONSITECLUB_MONTH=2026-08
